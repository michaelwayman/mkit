#!/usr/bin/env python3
"""mbuild: slices and multi-step runs on top of mkit. Zero model tokens.

Reads the spec only through the mkit CLI (check, state, brief, done, add, apply); never touches SPEC.md.

  mbuild plan [show|next|unsliced]   slices in .mbuild/plan.md, one per line: `B1: R1 R2`
                                     next = R ids of the first slice with unbuilt Rs
                                     unsliced = unbuilt Rs in no slice (added after the plan)
  mbuild status                      `mkit status` plus next slice and unsliced Rs
  mbuild run new|add|show|next|done|check|pause|approve
                                     multi-step run in .mbuild/run.md
  mbuild auto check|run|next|abort|status [--follow]  unattended slice loop (see below); state in .mbuild/auto.md

Run steps: mbuild run add <spec|build|action|wait|triage> | text | Do: cmd | Check: cmd
  build text lists R ids; action needs Do:; wait needs Check: (exit 0 = satisfied).
  run next exits 0 STEP/DONE, 3 WAIT, 4 PAUSED, 5 PLANNING (needs approve), 6 BLOCKED.
Auto: mbuild auto run [--max-slices N] [--max-budget-usd X] [--timeout SECS]
  Per slice: build session, verify gate, independent review session, fixed triage, then the
  driver (never a session) runs `mkit done` and commits. Each session is a fresh `claude -p`.
  Last output line is `STOP <reason>: <text>`; exit 0 finished, 3 budget, 4 decision, 6 spec/acceptance.
Override the mkit binary with $MKIT, claude with $CLAUDE, its extra flags with $MBUILD_CLAUDE_ARGS.
"""
import datetime
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time


class Err(Exception):
    pass


def find_root():
    d = os.getcwd()
    while True:
        if os.path.exists(os.path.join(d, "SPEC.md")) or os.path.isdir(os.path.join(d, ".mkit")):
            return d
        p = os.path.dirname(d)
        if p == d:
            raise Err("no SPEC.md found; run `mkit init` (mbuild needs the mkit plugin)")
        d = p


def paths(root):
    m = os.path.join(root, ".mbuild")
    return {"dir": m, "plan": os.path.join(m, "plan.md"), "run": os.path.join(m, "run.md")}


def read(p, default=""):
    try:
        with open(p) as f:
            return f.read()
    except IOError:
        return default


def write(p, text):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    tmp = p + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, p)


# ---------------------------------------------------------------- mkit seam
def mkit(root, *args):
    exe = os.environ.get("MKIT") or "mkit"
    try:
        r = subprocess.run([exe] + list(args), cwd=root, stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, universal_newlines=True)
    except OSError:
        raise Err("mkit not found on PATH (install the mkit plugin, or set $MKIT)")
    return r.returncode, r.stdout.strip()


def states(root, *ids):
    rc, out = mkit(root, "state", *ids)
    if rc != 0:
        raise Err(out)
    return dict(l.split(None, 1) for l in out.split("\n") if l.strip())


def spec_problems(root):
    rc, out = mkit(root, "check")
    return [] if rc == 0 else [l for l in out.split("\n") if l.strip()]


# ---------------------------------------------------------------- plan
PLAN_RE = re.compile(r"^B(\d+):\s*(.*)$")


def plan_parse(text):
    out = []
    for l in text.split("\n"):
        m = PLAN_RE.match(l.strip())
        if m:
            out.append((int(m.group(1)), re.findall(r"R\d+", m.group(2))))
    return out


def next_slice(root, plan):
    """R ids of the first slice that still has unbuilt, active Rs."""
    st = states(root)
    for _, rs in plan:
        todo = [x for x in rs if st.get(x) in ("todo", "reopened")]
        if todo:
            return todo
    return []


def unsliced(root, plan):
    planned = {x for _, rs in plan for x in rs}
    return [k for k, v in states(root).items() if v in ("todo", "reopened") and k not in planned]


def cmd_plan(args):
    root = find_root()
    p = paths(root)
    plan = plan_parse(read(p["plan"]))
    what = args[0] if args else "show"
    if what == "show":
        sys.stdout.write(read(p["plan"]) or "(no .mbuild/plan.md)\n")
    elif what == "next":
        print(" ".join(next_slice(root, plan)))
    elif what == "unsliced":
        print(" ".join(unsliced(root, plan)))
    else:
        raise Err("usage: mbuild plan [show|next|unsliced]")
    return 0


def cmd_status(args):
    root = find_root()
    p = paths(root)
    rc, out = mkit(root, "status")
    print(out)
    plan = plan_parse(read(p["plan"]))
    if not plan:
        print("next slice: (no .mbuild/plan.md)")
        return 0
    nxt = next_slice(root, plan)
    print("next slice: " + (" ".join(nxt) if nxt else "(all slices built)"))
    loose = unsliced(root, plan)
    if loose:
        print("unsliced: " + " ".join(loose) + " (added after the plan; /mbuild:build slices them)")
    return 0


# ---------------------------------------------------------------- run
RUN_KINDS = ("spec", "build", "action", "wait", "triage")
STEP_RE = re.compile(r"^(\d+)\. \[( |x)\] (\w+) \| (.*)$")
CHECK_TIMEOUT = 120


def run_parse(text):
    run = {"title": "", "status": "", "paused": "", "steps": []}
    for l in text.split("\n"):
        if l.startswith("# Run: "):
            run["title"] = l[7:].strip()
        elif l.startswith("Status: "):
            run["status"] = l[8:].strip()
        elif l.startswith("Paused: "):
            run["paused"] = l[8:].strip()
        else:
            m = STEP_RE.match(l)
            if m:
                parts = re.split(r"\s+\|\s+", m.group(4).strip())
                fields = {}
                for x in parts[1:]:
                    fm = re.match(r"^([A-Za-z]+):\s*(.*)$", x)
                    if fm:
                        fields[fm.group(1)] = fm.group(2)
                run["steps"].append({"n": int(m.group(1)), "done": m.group(2) == "x",
                                     "kind": m.group(3), "text": parts[0], "f": fields})
    return run


def run_render(run):
    out = ["# Run: " + run["title"], "Status: " + run["status"]]
    if run["paused"]:
        out.append("Paused: " + run["paused"])
    out.append("")
    for st in run["steps"]:
        extra = "".join(" | %s: %s" % kv for kv in st["f"].items())
        out.append("%d. [%s] %s | %s%s" % (st["n"], "x" if st["done"] else " ", st["kind"], st["text"], extra))
    return "\n".join(out) + "\n"


def run_load(root):
    text = read(paths(root)["run"])
    if not text:
        raise Err("no active run; start one with `mbuild run new \"<title>\"`")
    return run_parse(text)


def run_save(root, run):
    write(paths(root)["run"], run_render(run))


def run_check_cmd(root, cmd):
    try:
        res = subprocess.run(cmd, shell=True, cwd=root, timeout=CHECK_TIMEOUT,
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True)
    except subprocess.TimeoutExpired:
        return False, "timed out after %ds" % CHECK_TIMEOUT
    return res.returncode == 0, res.stdout.strip()[-200:]


def build_blocks(root, step):
    errs = spec_problems(root)
    ids = re.findall(r"\bR\d+\b", step["text"])
    st = states(root, *ids)
    for id_ in ids:
        if st.get(id_) in ("removed", "missing"):
            errs.append("%s is not an active requirement (removed, missing, or moved out of scope)" % id_)
    return errs


def run_finish(root, run):
    mkit(root, "apply", "LOG | RUN done: %s" % run["title"])
    run["status"] = "done"
    run_save(root, run)


def run_step_line(st):
    out = "STEP %d %s: %s" % (st["n"], st["kind"], st["text"])
    for k in ("Do", "Check"):
        if k in st["f"]:
            out += "\n%s: %s" % (k, st["f"][k])
    return out


def cmd_run(args):
    if not args:
        raise Err("usage: mbuild run new|add|show|next|done|check|pause|approve")
    verb, rest = args[0], args[1:]
    root = find_root()
    p = paths(root)
    if verb == "new":
        title = " ".join(rest).strip()
        if not title:
            raise Err('usage: mbuild run new "<title>"')
        old = read(p["run"])
        if old and run_parse(old)["status"] != "done":
            raise Err("a run is already active (%s); finish it or `mbuild run show`" % run_parse(old)["title"])
        run_save(root, {"title": title, "status": "planning", "paused": "", "steps": []})
        print("run started (planning); add steps with `mbuild run add`")
        return 0
    run = run_load(root)
    if verb == "show":
        sys.stdout.write(run_render(run))
        return 0
    if verb == "add":
        if run["status"] != "planning":
            raise Err("run is %s; steps can only be added while planning" % run["status"])
        segs = [x.strip() for x in re.split(r"\s+\|\s+", " ".join(rest))]
        if len(segs) < 2 or segs[0] not in RUN_KINDS:
            raise Err("usage: mbuild run add <%s> | text [| Do: cmd] [| Check: cmd]" % "|".join(RUN_KINDS))
        f = {}
        for x in segs[2:]:
            fm = re.match(r"^(Do|Check):\s*(.+)$", x)
            if not fm:
                raise Err("expected 'Do: cmd' or 'Check: cmd', got '%s'" % x)
            f[fm.group(1)] = fm.group(2)
        if segs[0] == "action" and "Do" not in f:
            raise Err("action needs 'Do: <command>'")
        if segs[0] == "wait" and "Check" not in f:
            raise Err("wait needs 'Check: <command>' (exit 0 = satisfied)")
        if segs[0] == "build" and not re.search(r"\bR\d+\b", segs[1]):
            raise Err("build needs requirement ids, e.g. 'R7 R8'")
        run["steps"].append({"n": len(run["steps"]) + 1, "done": False, "kind": segs[0],
                             "text": segs[1], "f": f})
        run_save(root, run)
        print("step %d" % len(run["steps"]))
        return 0
    if verb == "approve":
        if run["status"] != "planning" or not run["steps"]:
            raise Err("nothing to approve (status %s, %d steps)" % (run["status"], len(run["steps"])))
        for st in run["steps"]:
            if st["kind"] == "action":
                st["f"]["Approved"] = "yes"
        run["status"] = "running"
        run_save(root, run)
        print("approved; %d steps" % len(run["steps"]))
        return 0
    if verb == "pause":
        q = " ".join(rest).strip()
        if not q:
            raise Err('usage: mbuild run pause "<question>"')
        rc, out = mkit(root, "apply", "ADD Q | " + q)
        m = re.search(r"added (Q\d+)", out)
        if rc != 0 or not m:
            raise Err("could not record the question: " + out)
        qid = m.group(1)
        run["status"], run["paused"] = "paused", "%s %s" % (qid, q)
        run_save(root, run)
        print("paused on %s; answer it, then `mbuild run next`" % qid)
        return 0
    if verb in ("next", "check", "done"):
        return run_advance(root, run, verb, rest)
    raise Err("unknown run verb: %s" % verb)


def run_advance(root, run, verb, rest):
    if run["status"] == "done":
        print("DONE")
        return 0
    if run["status"] == "planning":
        print("PLANNING: show `mbuild run show`, get the user's approval, then `mbuild run approve`")
        return 5
    if run["status"] == "paused":
        qid = run["paused"].split()[0]
        if states(root, qid).get(qid) not in ("answered", "removed"):
            print("PAUSED: " + run["paused"])
            return 4
        run["status"], run["paused"] = "running", ""
        run_save(root, run)
    while True:
        todo = [st for st in run["steps"] if not st["done"]]
        if not todo:
            if spec_problems(root):
                print("BLOCKED: all steps done but `mkit check` fails")
                run_save(root, run)
                return 6
            run_finish(root, run)
            print("DONE")
            return 0
        st = todo[0]
        if verb == "done":
            if st["kind"] == "build":
                ids = re.findall(r"\bR\d+\b", st["text"])
                undone = [i for i, v in states(root, *ids).items() if v != "built"]
                if undone:
                    print("BLOCKED: %s not built and verified; run `mkit done`" % " ".join(undone))
                    return 6
            elif st["kind"] == "wait":
                ok, out = run_check_cmd(root, st["f"]["Check"])
                if not ok:
                    print("BLOCKED: wait not satisfied: %s" % out)
                    return 6
            want = int(rest[0]) if rest and rest[0].isdigit() else st["n"]
            if want != st["n"]:
                print("BLOCKED: step %d is next, not %d" % (st["n"], want))
                return 6
            st["done"] = True
            run_save(root, run)
            print("step %d done" % st["n"])
            return 0
        if st["kind"] == "wait":
            ok, out = run_check_cmd(root, st["f"]["Check"])
            if ok:
                st["done"] = True
                run["status"] = "running"
                run_save(root, run)
                continue
            run["status"] = "waiting"
            run_save(root, run)
            print("WAIT %d: %s (check failed: %s)" % (st["n"], st["text"], out or "no output"))
            return 3
        if st["kind"] == "build":
            errs = build_blocks(root, st)
            if errs:
                print("BLOCKED %d: spec would break:\n%s" % (st["n"], "\n".join(errs)))
                return 6
        if st["kind"] == "action" and st["f"].get("Approved") != "yes":
            print("BLOCKED %d: action not approved" % st["n"])
            return 6
        if verb == "check":
            print("STEP %d is not a wait" % st["n"])
            return 0
        run["status"] = "running"
        run_save(root, run)
        print(run_step_line(st))
        return 0

# ---------------------------------------------------------------- auto
MAX_FIX = 2
BLOCKING = ("fail", "bug")
STOPPING = ("constraint", "scope")
BUILD_PROMPT = "/mbuild:build %s --auto"
REVIEW_PROMPT = "/mbuild:review %s --base %s --auto"
FIX_PROMPT = ("Fix only these findings for %s, in the working tree. Do not run `mkit done`, do not commit, "
              "do not edit SPEC.md. Rerun every acceptance bullet and rewrite %s "
              "(one line per bullet: `R1.1 | pass|fail | evidence`). If unsure, write `NEEDS: <question>` to %s.\n\n%s")


class Stop(Exception):
    def __init__(self, reason, text, rc):
        Exception.__init__(self, text)
        self.reason, self.text, self.rc = reason, text, rc


def auto_dir(root, n):
    return os.path.join(paths(root)["dir"], "auto", "B%d" % n)


def auto_log(root, line):
    p = os.path.join(paths(root)["dir"], "auto.md")
    write(p, read(p) + line + "\n")


def auto_set(root, key, value):
    """Keep one `Key: value` header line current at the top of auto.md (Status first)."""
    p = os.path.join(paths(root)["dir"], "auto.md")
    lines = [l for l in read(p).split("\n") if l]
    head = {l.split(":", 1)[0]: l for l in lines if re.match(r"^(Status|Phase): ", l)}
    rest = [l for l in lines if not re.match(r"^(Status|Phase): ", l)]
    head[key] = "%s: %s" % (key, value)
    write(p, "\n".join([head[k] for k in ("Status", "Phase") if k in head] + rest) + "\n")


def auto_status(root, status):
    auto_set(root, "Status", status)
    if status != "running":
        auto_set(root, "Phase", "-")


def git(root, *args):
    r = subprocess.run(["git"] + list(args), cwd=root, stdout=subprocess.PIPE,
                       stderr=subprocess.STDOUT, universal_newlines=True)
    return r.returncode, r.stdout.strip()


def claude(root, prompt, opts, d, phase):
    exe = os.environ.get("CLAUDE") or "claude"
    cmd = [exe, "-p", prompt, "--permission-mode", "acceptEdits", "--output-format", "stream-json", "--verbose"] + shlex.split(os.environ.get("MBUILD_CLAUDE_ARGS", ""))
    if opts.get("budget"):
        cmd += ["--max-budget-usd", opts["budget"]]
    env = dict(os.environ, MBUILD_AUTO="1")
    log = os.path.join(d, phase + ".log")
    auto_set(root, "Phase", "%s %s (log %s)" % (os.path.basename(d), phase, os.path.relpath(log, root)))
    try:
        with open(log, "w") as lf:
            r = subprocess.run(cmd, cwd=root, env=env, timeout=opts["timeout"], stdout=lf,
                               stderr=subprocess.STDOUT, universal_newlines=True)
    except subprocess.TimeoutExpired:
        raise Stop("budget", "session timed out after %ds" % opts["timeout"], 3)
    except OSError:
        raise Stop("decision", "claude not found on PATH (set $CLAUDE)", 4)
    if r.returncode != 0:
        raise Stop("decision", "%s exited %d: %s (log %s)" % (phase, r.returncode, read(log).strip()[-200:], os.path.relpath(log, root)), 4)


def bullets_of(root, rid):
    rc, out = mkit(root, "show", rid)
    got, on = [], False
    for l in out.split("\n"):
        if l.startswith("- Acceptance:"):
            on = True
        elif on and l.startswith("  - "):
            got.append(l[4:].strip())
        elif on:
            break
    return got


def verify_gate(root, rs, d):
    """Problems (list of 'R.k: why'); empty only when every bullet of every R is recorded as pass."""
    rec = {}
    for l in read(os.path.join(d, "verify.md")).split("\n"):
        parts = [x.strip() for x in l.split("|", 2)]
        if len(parts) >= 2 and re.match(r"^R\d+\.\d+$", parts[0]):
            rec[parts[0]] = (parts[1].lower(), parts[2] if len(parts) > 2 else "")
    probs = []
    for rid in rs:
        bl = bullets_of(root, rid)
        if not bl:
            probs.append("%s: no acceptance bullets" % rid)
        for k, text in enumerate(bl, 1):
            key = "%s.%d" % (rid, k)
            verdict = rec.get(key)
            if verdict is None:
                probs.append("%s: not verified (%s)" % (key, text))
            elif verdict[0] != "pass":
                probs.append("%s: %s (%s) %s" % (key, verdict[0], text, verdict[1]))
    return probs


def needs(d):
    t = read(os.path.join(d, "NEEDS")).strip()
    return t or None


def load_review(d):
    try:
        data = json.loads(read(os.path.join(d, "review.json")))
        return [f for f in data["findings"] if isinstance(f, dict)]
    except (ValueError, KeyError, TypeError):
        return None


def preflight(root):
    rc, out = mkit(root, "frame")
    if out.startswith("Stage") and not out.startswith("Stage done"):
        return "frame is not finished (%s); run /mkit:frame" % out.split("\n")[0]
    probs = spec_problems(root)
    if probs:
        return "mkit check fails: " + probs[0]
    return None


def dirty(root):
    """Uncommitted changes other than mbuild/mkit state and SPEC.md (which mkit edits between slices)."""
    rc, out = git(root, "status", "--porcelain")
    return [l for l in out.split("\n") if l.strip()
            and not re.match(r"^\s*\S{1,2}\s+\"?(\.mbuild/|\.mkit/|SPEC\.md$)", l)]


def auto_branch(root):
    """Work only on an mbuild/ branch, so the user's branch is never touched. Returns its name."""
    rc, cur = git(root, "rev-parse", "--abbrev-ref", "HEAD")
    if rc != 0:
        raise Stop("spec", "not a git repo with a commit; auto commits one per slice", 6)
    if cur.startswith("mbuild/"):
        return cur
    name = "mbuild/auto-" + datetime.date.today().isoformat()
    if git(root, "rev-parse", "--verify", "-q", name)[0] == 0:
        rc, out = git(root, "checkout", "-q", name)
    else:
        rc, out = git(root, "checkout", "-q", "-b", name)
    if rc != 0:
        raise Stop("spec", "could not switch to %s: %s" % (name, out), 6)
    return name


def state_path(root):
    return os.path.join(paths(root)["dir"], "auto", "state.json")


def state_load(root):
    try:
        return json.loads(read(state_path(root)))
    except ValueError:
        return None


def state_save(root, st):
    write(state_path(root), json.dumps(st))


def state_drop(root):
    try:
        os.remove(state_path(root))
    except OSError:
        pass


def spawn(root, st, label, prompt):
    """Record which session is out, and hand the caller its prompt (also saved beside the logs)."""
    sl = st["slice"]
    sl["pending"] = label
    d = auto_dir(root, sl["n"])
    write(os.path.join(d, label + ".prompt"), prompt)
    state_save(root, st)
    return {"label": label, "prompt": prompt, "dir": d, "n": sl["n"]}


def blocked(root, st, findings):
    sl = st["slice"]
    if sl["tries"] >= MAX_FIX:
        for f in findings:
            mkit(root, "add", "B%d: %s" % (sl["n"], f["text"]), "--bug")
        raise Stop("acceptance", "B%d still failing after %d fix passes: %s" % (sl["n"], MAX_FIX, findings[0]["text"]), 6)
    sl["tries"] += 1
    d = auto_dir(root, sl["n"])
    listing = "\n".join("- %s: %s" % (f["kind"], f["text"]) for f in findings)
    prompt = FIX_PROMPT % (" ".join(sl["rs"]), os.path.join(d, "verify.md"), os.path.join(d, "NEEDS"), listing)
    return spawn(root, st, "fix%d" % sl["tries"], prompt)


def after_work(root, st):
    """A build or fix session ended: human needed? verify gate? then ask for the independent review."""
    sl = st["slice"]
    d = auto_dir(root, sl["n"])
    q = needs(d)
    if q:
        raise Stop("decision", "B%d needs a decision: %s" % (sl["n"], q), 4)
    probs = verify_gate(root, sl["rs"], d)
    if probs:
        return blocked(root, st, [{"kind": "fail", "text": x} for x in probs])
    try:
        os.remove(os.path.join(d, "review.json"))
    except OSError:
        pass
    return spawn(root, st, "review%d" % sl["tries"], REVIEW_PROMPT % (" ".join(sl["rs"]), sl["base"]))


def after_review(root, st):
    """The review ended: fixed triage. Returns a fix action, or None once the slice is closed."""
    sl = st["slice"]
    d = auto_dir(root, sl["n"])
    rev = load_review(d)
    if rev is None:
        raise Stop("acceptance", "B%d review wrote no valid review.json" % sl["n"], 6)
    findings = []
    for f in rev:
        kind, text = f.get("kind", ""), str(f.get("text", "")).strip()
        if kind in STOPPING:
            raise Stop("spec", "B%d %s: %s" % (sl["n"], kind, text), 6)
        if kind == "drift" and text not in sl["filed"]:
            sl["filed"].append(text)
            mkit(root, "add", text, "--adjust")
        elif kind in BLOCKING:
            findings.append({"kind": kind, "text": text})
    if findings:
        return blocked(root, st, findings)
    # closed only here: verify passed and the independent review found nothing blocking.
    # Commit first, then mark built and fold SPEC.md into the same commit, so spec and git cannot diverge.
    ids = " ".join(sl["rs"])
    git(root, "add", "-A", "--", ".", ":(exclude).mbuild", ":(exclude).mkit")
    git(root, "commit", "-q", "--allow-empty", "-m", "B%d: %s" % (sl["n"], ids))
    rc, out = mkit(root, "done", *sl["rs"])
    if rc != 0:
        raise Stop("spec", "mkit done failed: " + out, 6)
    git(root, "add", "SPEC.md")
    git(root, "commit", "-q", "--amend", "--no-edit")
    auto_log(root, "B%d: %s built (%d fix passes)" % (sl["n"], ids, sl["tries"]))
    st["done_n"] += 1
    st["slice"] = None
    state_save(root, st)
    return None


def ready(root, plan):
    """Why a run cannot start, as (text, exit code), or None."""
    if not plan:
        return "no .mbuild/plan.md; run /mbuild:build once to slice", 4
    loose = unsliced(root, plan)
    if loose:
        return "unsliced Rs %s; run /mbuild:build to slice them" % " ".join(loose), 4
    why = preflight(root)
    return (why, 6) if why else None


def advance(root, max_slices):
    """Evaluate whatever session just ended and return the next session to run (a dict), or raise Stop.
    State lives in .mbuild/auto/state.json, so a caller that spawns sessions itself can drive this."""
    p = paths(root)
    st = state_load(root)
    if st is None:
        plan = plan_parse(read(p["plan"]))
        r = ready(root, plan)
        if r:
            raise Stop("spec" if r[1] == 6 else "decision", r[0], r[1])
        bad = dirty(root)
        if bad:
            raise Stop("spec", "working tree not clean (%s); commit or stash first" % bad[0].strip(), 6)
        write(os.path.join(p["dir"], "auto.md"), "Status: running\n")
        auto_log(root, "branch " + auto_branch(root))
        st = {"done_n": 0, "max": max_slices, "slice": None}
        state_save(root, st)
    while True:
        sl = st["slice"]
        if sl is None:
            plan = plan_parse(read(p["plan"]))
            rs = next_slice(root, plan)
            if not rs:
                if unsliced(root, plan):
                    raise Stop("decision", "new Rs were added mid-run; run /mbuild:build to slice them", 4)
                if spec_problems(root):
                    raise Stop("spec", "all slices built but `mkit check` fails", 6)
                raise Stop("finished", "%d slices built, verified and reviewed" % st["done_n"], 0)
            if st["max"] is not None and st["done_n"] >= st["max"]:
                raise Stop("budget", "stopped after %d slices (--max-slices)" % st["done_n"], 3)
            why = preflight(root)
            if why:
                raise Stop("spec", why, 6)
            n = [k for k, r in plan if set(rs) & set(r)][0]
            d = auto_dir(root, n)
            shutil.rmtree(d, ignore_errors=True)
            os.makedirs(d)
            st["slice"] = {"n": n, "rs": rs, "base": git(root, "rev-parse", "HEAD")[1], "tries": 0,
                           "filed": [], "pending": None}
            return spawn(root, st, "build", BUILD_PROMPT % " ".join(rs))
        act = after_review(root, st) if sl["pending"].startswith("review") else after_work(root, st)
        if act:
            return act


def finalize(root, s):
    """A run ended: keep any partial slice as a WIP commit, drop run state, record and set the status."""
    st = state_load(root)
    sl = st and st.get("slice")
    if sl and s.reason != "finished" and dirty(root):
        git(root, "add", "-A", "--", ".", ":(exclude).mbuild", ":(exclude).mkit")
        git(root, "commit", "-q", "-m", "WIP B%d: %s (%s)" % (sl["n"], " ".join(sl["rs"]), s.reason))
        s.text += " [partial work kept as commit 'WIP B%d'; to discard: git reset --hard %s]" % (sl["n"], sl["base"][:10])
    state_drop(root)
    auto_log(root, "STOP %s: %s" % (s.reason, s.text))
    auto_status(root, "done" if s.reason == "finished" else "stopped")
    print("STOP %s: %s" % (s.reason, s.text))
    return s.rc


def auto_opts(args):
    o = {"max": None, "budget": None, "timeout": 3600}
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--max-slices", "--max-budget-usd", "--timeout") and i + 1 < len(args):
            key = {"--max-slices": "max", "--max-budget-usd": "budget", "--timeout": "timeout"}[a]
            o[key] = int(args[i + 1]) if key != "budget" else args[i + 1]
            i += 2
        else:
            raise Err("usage: mbuild auto run [--max-slices N] [--max-budget-usd X] [--timeout SECS]")
    return o


def auto_follow(root):
    """Tail the newest session log until the run stops (or print its end if it already has)."""
    base = os.path.join(paths(root)["dir"], "auto")
    logs = [os.path.join(dp, f) for dp, _, fs in os.walk(base) for f in fs if f.endswith(".log")]
    if not logs:
        return 0
    cur = max(logs, key=os.path.getmtime)
    print("--- " + os.path.relpath(cur, root))
    pos = 0
    while True:
        with open(cur) as f:
            f.seek(pos)
            for l in f:
                print(l.rstrip()[:200])
            pos = f.tell()
        sys.stdout.flush()
        if "Status: running" not in read(os.path.join(paths(root)["dir"], "auto.md")):
            return 0
        time.sleep(2)
        newer = max([cur] + [x for x in logs if os.path.getmtime(x) > os.path.getmtime(cur)])
        if newer != cur:
            cur, pos = newer, 0
            print("--- " + os.path.relpath(cur, root))


def cmd_auto(args):
    if not args or args[0] not in ("check", "run", "next", "abort", "status"):
        raise Err("usage: mbuild auto check|run|next|abort|status")
    root = find_root()
    p = paths(root)
    verb = args[0]
    if verb == "status":
        sys.stdout.write(read(os.path.join(p["dir"], "auto.md")) or "(no auto run)\n")
        return auto_follow(root) if "--follow" in args[1:] else 0
    if verb == "check":
        r = ready(root, plan_parse(read(p["plan"])))
        print("ok" if not r else "NOT READY: " + r[0])
        return 0 if not r else 6
    if verb == "abort":
        # a caller that spawns sessions itself reports one that failed or timed out
        return finalize(root, Stop("decision", " ".join(args[1:]) or "aborted", 4))
    opts = auto_opts(args[1:])
    try:
        if verb == "next":
            act = advance(root, opts["max"])
            print("SPAWN %s B%d\nPrompt: %s" % (act["label"], act["n"], os.path.join(act["dir"], act["label"] + ".prompt")))
            return 0
        while True:
            act = advance(root, opts["max"])
            claude(root, act["prompt"], opts, act["dir"], act["label"])
    except Stop as s:
        return finalize(root, s)



COMMANDS = {"plan": cmd_plan, "status": cmd_status, "run": cmd_run, "auto": cmd_auto}


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help") or argv[1] not in COMMANDS:
        sys.stdout.write(__doc__)
        return 0 if len(argv) < 2 or argv[1] in ("-h", "--help") else 2
    try:
        return COMMANDS[argv[1]](argv[2:])
    except Err as e:
        sys.stderr.write("mbuild: %s\n" % e)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
